#!/bin/bash
# ABOUTME: Removes merged or abandoned Claude worktrees under ~/repos/[<group>/]<repo>/.claude/worktrees,
# ABOUTME: keeping any with unpushed work, uncommitted changes or a live session. Run by hand.
#
# HOOK_DRY_RUN=1 logs what it would remove without touching anything. The log
# is /tmp/worktree-hooks-<date>.log, shared with the session-start hook.

set -u
PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH"

# The helpers live beside this script in the dotfiles repo (base/.claude/hooks);
# resolve the symlink ~/.local/bin points through to find them.
here=$(dirname "$(readlink -f "$0")")
# shellcheck source=../../.claude/hooks/_common.sh
source "$here/../../.claude/hooks/_common.sh"

setup_logging "[sweep]"
echo "" >> "$LOGFILE"
if is_dry_run; then
	log "--- worktree sweep (dry run) ---"
else
	log "--- worktree sweep ---"
fi

# Main checkouts at ~/repos/<repo> and ~/repos/<group>/<repo>. Only a .git
# directory marks a main checkout (a worktree has a .git file), the glob skips
# dot directories such as .claude, and node_modules is never a project.
for repo in "$HOME"/repos/*/ "$HOME"/repos/*/*/; do
	repo="${repo%/}"
	case "$repo" in
		*/node_modules) continue ;;
	esac
	[ -d "$repo/.git" ] || continue
	[ -d "$repo/.claude/worktrees" ] || continue
	name="${repo#"$HOME"/repos/}"
	git -C "$repo" rev-parse --verify --quiet HEAD >/dev/null 2>&1 || continue
	default=$(detect_default_branch "$repo")
	if [ -z "$default" ]; then
		log "⏭ $name: no default branch, skipped"
		continue
	fi
	# Measure against origin's tip: the main checkout's own branch may lag.
	base="$default"
	if git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$default"; then
		base="origin/$default"
	fi
	log "repo $name (against $base)"
	clean_stale_worktrees "$repo" "$base"
done
