#!/bin/bash
# ABOUTME: Runs the real rex CLI, but refuses commands that kill Rex servers or sessions
# ABOUTME: when a coding agent (CLAUDECODE=1) runs them, even from inside a script.
#
# On 2026-11-14 an agent's test script ran `rex server stop` aimed at a throwaway
# server; Rex fell back to the real one and every program in every pane died.
# Agents stop their own test servers by pid instead. David runs these himself.
#
# Keep this bash 3.2 clean: that is what /bin/bash is on macOS.
set -u

self_dir=$(cd "$(dirname "$0")" && pwd -P)

# The real rex: Rex's own bin directory, else the next rex on PATH after this one
real=""
if [ -n "${REX_BIN_DIR:-}" ] && [ -x "$REX_BIN_DIR/rex" ]; then
    real="$REX_BIN_DIR/rex"
else
    old_ifs=$IFS
    IFS=:
    for dir in $PATH; do
        [ -x "$dir/rex" ] || continue
        [ "$(cd "$dir" 2>/dev/null && pwd -P)" = "$self_dir" ] && continue
        real="$dir/rex"
        break
    done
    IFS=$old_ifs
fi
[ -n "$real" ] || { echo "rex: the Rex CLI is not installed" >&2; exit 127; }

if [ "${CLAUDECODE:-}" = "1" ]; then
    # The first two words that are not options, skipping the values of global
    # options that take one (-S, --server, -C, --client, --timeout, --color)
    first=""
    second=""
    skip=0
    for arg in "$@"; do
        if [ "$skip" = 1 ]; then skip=0; continue; fi
        case "$arg" in
            -S|--server|-C|--client|--timeout|--color) skip=1 ;;
            -*) ;;
            *)
                if [ -z "$first" ]; then first=$arg
                elif [ -z "$second" ]; then second=$arg
                fi
                ;;
        esac
    done
    case "$first $second" in
        "server stop"|"server uninstall"|"session kill"|"kill "*)
            echo "rex: agents may not run 'rex $first $second': it kills every program in the server's panes." >&2
            echo "rex: stop a test server by its pid, or ask David to run this." >&2
            exit 1
            ;;
    esac
fi

exec "$real" "$@"
