{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Follow Cloudflare's cf CLI prereleases, up to what npm tags latest",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["cf"],
      "ignoreUnstable": false
    }
  ]
}
