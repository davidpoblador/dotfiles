# Machine-local host aliases (internal hostnames stay out of the public repo)
Include config.local

IgnoreUnknown UseKeychain

# Added by "rex terminfo setup". Remove it with "rex terminfo remove".
# Rex owns this file and keeps a per-host record of which machines have its
# terminfo entry, so only those are sent TERM=xterm-rex. Missing elsewhere,
# and ssh ignores an Include it cannot find.
Include "~/.config/rex/ssh_config"

# A TERM the remote host has never heard of stops curses programs running there
# at all, so announce a name every host knows. Rex's own guard above already
# covers xterm-rex per host, which is why this one steps aside for it: ssh keeps
# the first SetEnv it parses, so a blanket one here would override those records.
# `rex terminfo status` reports this block as overriding them anyway; it does not
# evaluate the Match, and `ssh -G` on a recorded host shows no SetEnv at all.
#
# Keep this block last before the Host sections: a Match block runs until the
# next Host or Match line, so anything placed under it would be conditional too.
Match exec "[ x$TERM != xxterm-rex ]"
    SetEnv TERM=xterm-256color

Host github.com
    # There are wifi networks in cafés that do not play well with ssh
    # HostName github.com
    Hostname ssh.github.com
    Port 443
    User git
    IdentityFile ~/.ssh/id_ed25519

    AddKeysToAgent yes
    PreferredAuthentications publickey
    UpdateHostKeys yes
    Compression yes
    TCPKeepAlive yes
    ServerAliveInterval 60

# Defaults last: ssh takes the first value per keyword, so specific
# Host blocks above must come first to take effect
Host *
    User dpoblador
    # Compatibility
    AddressFamily any

    # Use the more secure ed25519 key by default
    IdentityFile ~/.ssh/id_ed25519
    
    # Enable multiplexing and socket reuse
    ControlMaster auto
    ControlPath /tmp/socket-%r@%h:%p
    ControlPersist 10m
    
    # Use more secure ciphers and key exchange algorithms
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
    KexAlgorithms curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256
    
    # Enable compression for faster transfers
    Compression yes
    
    # Keep the connection alive
    ServerAliveInterval 60
    ServerAliveCountMax 5
    
    # Use the SFTP subsystem for file transfers
    # Subsystem sftp /usr/lib/ssh/sftp-server
    
    # Disable X11 forwarding for security (unless you need it)
    ForwardX11 no

    # Enable Agent Forwarding
    ForwardAgent yes
    
    # Use stronger MAC algorithms
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

    # Add keys to SSH agent
    AddKeysToAgent yes
    UseKeychain yes

    EscapeChar ~

# GitHub configuration
